# Wyłączenie listowania katalogów
Options -Indexes

# Blokada bezpośredniego dostępu HTTP do tokenu, cache'u, sekretów, baz SQLite oraz danych webhooka
<FilesMatch "^(token\.txt|last_event\.txt|cache_.*\.json|package(-lock)?\.json|\.git.*|README\.md|webhook_.*|marketplace_.*\.json|\.env.*|.*\.sqlite[0-9]?|.*\.db.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Nagłówki bezpieczeństwa HTTP
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
